#!/bin/bash
# Brewfile hash: {{ includeTemplate "dot_config/private_homebrew/Brewfile.tmpl" . | sha256sum }}
# mise config hash: {{ includeTemplate "dot_config/mise/config.toml.tmpl" . | sha256sum }}

set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
# 1. Base system packages.
#
# Only the floor needed to bootstrap everything else: a shell, git, a fetcher,
# a compiler for mise backends that build, and gpg. Real tooling comes from mise.
{{   $id := .chezmoi.osRelease.id -}}
{{   $like := get .chezmoi.osRelease "idLike" | default "" -}}
# Request a package only when the command it provides is actually missing.
#
# Amazon Linux 2023 preinstalls stripped variants such as curl-minimal and
# gnupg2-minimal, which already provide the command and declare a conflict with
# the full package. Naming the full package outright makes dnf refuse the whole
# transaction, so asking only for what is genuinely absent avoids that entire
# class of conflict rather than special-casing each one.
PKGS=""
need() { command -v "$1" &> /dev/null || PKGS="$PKGS $2"; }

{{   if or (eq $id "debian") (eq $id "ubuntu") (contains "debian" $like) -}}
need zsh zsh
need git git
need curl curl
need gpg gnupg
need gcc build-essential
need make build-essential
{{     if eq .chezmoi.arch "arm64" -}}
need nnn nnn
{{     end -}}
if [[ -n "$PKGS" ]]; then
    sudo apt-get update
    sudo apt-get install -y ${PKGS}
else
    echo "Base packages already present."
fi
{{   else if or (eq $id "amzn") (eq $id "fedora") (eq $id "rhel") (contains "fedora" $like) (contains "rhel" $like) -}}
need zsh zsh
need git git
need curl curl
need gpg gnupg2
need gcc gcc
need make make
{{     if eq .chezmoi.arch "arm64" -}}
need nnn nnn
{{     end -}}
if [[ -n "$PKGS" ]]; then
    sudo dnf install -y ${PKGS}
else
    echo "Base packages already present."
fi
{{   else -}}
echo "ERROR: unsupported distro '{{ $id }}' (ID_LIKE='{{ $like }}')." >&2
echo "Add a branch for it in run_onchange_install-packages.sh.tmpl and re-run." >&2
exit 1
{{   end -}}
{{ end }}
{{ if eq .chezmoi.os "darwin" -}}
# 2. Homebrew. macOS only, and only for what mise cannot serve as a binary.
if ! command -v brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle --file="$HOME/.config/homebrew/Brewfile"
{{ end }}
# 3. mise. Owns every CLI and runtime it can install as a prebuilt binary.
if ! command -v mise &> /dev/null; then
    curl https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"

mise install -y
# 4. Self-updating tools, via their own installers.
#
# These ship an `upgrade` subcommand and replace their own binary, so a version
# manager is the wrong home for them: mise would pin a version the tool then
# overwrites, leaving `mise ls` reporting something that is not installed.
# Each guard stops the installer re-running once the tool is present, since the
# tool handles its own updates from then on.
{{ if not .work }}
# Work machines get an internally-configured Claude Code build instead.
if ! command -v claude &> /dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}
{{ if not .minimal }}
if ! command -v opencode &> /dev/null; then
    curl -fsSL https://opencode.ai/install | bash
fi
{{ end }}
