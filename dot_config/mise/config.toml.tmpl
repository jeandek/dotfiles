[tools]
# Shell experience. Identical on every machine, including minimal ones.
starship = "latest"
bat = "latest"
eza = "latest"
fzf = "latest"
zoxide = "latest"
ripgrep = "latest"
delta = "latest"
jq = "latest"
shellcheck = "latest"
"github:simeji/jid" = "latest"
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") -}}
# Upstream publishes x86_64 Linux statics only. Elsewhere nnn comes from
# Homebrew (macOS) or the distro package list (arm64 Linux).
"github:jarun/nnn" = "latest"
{{ end -}}

{{ if not .minimal }}
# Cloud tooling. Not needed on a box that only runs services.
awscli = "latest"

# Language runtimes and the tools that depend on them.
go = "latest"
node = "lts"
python = "latest"
ruby = "latest"
rust = "latest"
uv = "latest"

# Package managers
"npm:npm" = "latest"
"npm:pnpm" = "latest"

# CLI helpers
"pipx:tldr" = "latest"

# CLIs
"npm:@bitwarden/cli" = "latest"
"github:jesseduffield/lazygit" = "latest"
# Upstream ships bare, unarchived release binaries, which mise only finds via an
# explicit asset_pattern, and names the arches aarch64/x86_64 rather than mise's
# own arm64/amd64 — so the pattern cannot use mise's {arch} placeholder either.
"github:herdrdev/herdr" = { version = "latest", asset_pattern = "herdr-{os}-{{ if eq .chezmoi.arch "arm64" }}aarch64{{ else }}x86_64{{ end }}" }

# Javascript
"npm:prettier" = "latest"
"npm:@antfu/ni" = "latest"
{{ end }}
[settings]
experimental = true
