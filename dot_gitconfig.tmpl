[user]
	name = Jean de Kernier
	email = {{ .email | quote }}
	signingkey = B813782A74BB6703

[core]
	editor = vim
	pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between diff sections
	side-by-side = true

[init]
  defaultBranch = main

[fetch]
  prune = true

[merge]
  conflictstyle = diff3

[alias]
	a = add
	b = branch
	c = commit -m
	cl = clone
	co = checkout
	cp = cherry-pick
	fp = "push --force-with-lease"
	last = log -1 HEAD
	m = merge
	p = push --follow-tags
	pu = pull
	r = reset
	s = status
	move-branch = "!f() { \
    		: git checkout \
    		git rebase --onto $2 $(git merge-base $1 @) \
		}; f"
	stash-staged = "!$HOME/.config/bin/git/stash-staged"
