# Pre-hooks. Machine-local drop-ins, not managed by this repo.
# Loaded before oh-my-zsh and before $path is set up below.
for _f in ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/rc.pre.d/*.zsh(N); do source "$_f"; done
unset _f

# ZSH configuration
export ZSH="$HOME/.oh-my-zsh"
HIST_STAMPS="yyyy-mm-dd"
# Updates are managed through chezmoi externals
zstyle ':omz:update' mode disabled

# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
plugins=(
  aliases
  aws
  colored-man-pages
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# User configuration
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR='vim'
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="/Users/$USER/Library/pnpm"
{{ else if eq .chezmoi.os "linux" -}}
export PNPM_HOME="/home/$USER/.local/share/pnpm"
{{ end }}
# Tools. `typeset -U` keeps $path free of duplicates, and the (N) glob
# qualifier silently drops entries that do not exist on this machine.
typeset -U path PATH
path=(
  $HOME/.local/bin(N)
  $HOME/.antigravity/antigravity/bin(N)
  $HOME/.opencode/bin(N)
  $PNPM_HOME(N)
  $path
)

eval "$($HOME/.local/bin/mise activate zsh)"
source <(fzf --zsh)
eval "$(zoxide init zsh)"

# Pull the latest dotfiles and reconcile this machine. Applies the optional
# second source directory too, when one is present.
dotfiles-update() {
  chezmoi update || return
  local extra="$HOME/.local/share/chezmoi-work"
  [[ -d "$extra" ]] && chezmoi -S "$extra" update
}

# Aliases
alias cat="bat"

alias ga="git add"
alias gA="git add --all"
alias gc="git commit"
alias gcm="git commit -m"
alias gco="git checkout"
alias gcob="git checkout -b"
alias gl="git log"
alias gp="git push"
alias gpl="git pull --rebase"
alias gs="git status"
alias gst="git stash"

alias cma="chezmoi add"
alias cmcd="chezmoi cd"
alias cme="chezmoi edit --apply"
alias doco="docker compose"
alias findempty="find . -type d --empty"
alias ls="eza"
alias ll="eza -lh"
alias lsa="eza -lah"
alias lsg="eza -lh --git"
alias mcpi="npx @modelcontextprotocol/inspector"
alias nnn="nnn -e"

eval "$(starship init zsh)"

# Post-hooks. Machine-local drop-ins, not managed by this repo.
# Anything prepended to $path here wins over the entries set above.
for _f in ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/rc.post.d/*.zsh(N); do source "$_f"; done
unset _f
