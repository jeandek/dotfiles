# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ZSH configuration

export ZSH="/home/jean/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
HIST_STAMPS="yyyy-mm-dd"

# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
plugins=(aws colored-man-pages zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# User configuration

export EDITOR='vim'

# Tools

# pipx
export PATH="/home/jean/.local/bin:$PATH"
export PIPX_DEFAULT_PYTHON="$HOME/.pyenv/versions/3.11.3/bin/python"
# pyenv
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# add ASDF to $PATH and set up completions
. "$HOME/.asdf/asdf.sh"
fpath=(${ASDF_DIR}/completions $fpath)

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

eval "$(jump shell)"

autoload -Uz compinit && compinit
source "${XDG_CONFIG_HOME:-$HOME/.config}/asdf-direnv/zshrc"

# Aliases

alias doco="docker compose"
alias findempty= "find . -type d --empty"
alias ls="exa"
alias ll="exa -lh"
alias lsa="exa -lah"
alias lsg="exa -lh --git"

