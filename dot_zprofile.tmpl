# Pre-hooks. Machine-local drop-ins, not managed by this repo.
for _f in ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/profile.pre.d/*.zsh(N); do source "$_f"; done
unset _f

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}

eval "$("${HOME}/.local/bin/mise" activate zsh --shims)"

# Post-hooks. Machine-local drop-ins, not managed by this repo.
for _f in ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/profile.post.d/*.zsh(N); do source "$_f"; done
unset _f
